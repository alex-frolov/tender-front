# openapi-typescript@7.13.0 объявляет peer typescript@^5.x, а проект на
# typescript ~6.0 — из-за этого `npm ci` падает с ERESOLVE. Генератор типов
# с TS 6 работает (npm run gen), поэтому конфликт peer'ов игнорируем здесь,
# а не флагом в CI: локальная и CI-установка должны быть одинаковыми.
legacy-peer-deps=true
